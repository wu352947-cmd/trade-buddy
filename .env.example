# Trade Buddy 本地版可选数据源与公开源配置模板
# ------------------------------------------------------------------
# 说明：
# 1. 不配置任何 Key 时，Trade Buddy 会自动使用仓库内捆绑的真实历史样本日线/60m 数据，
#    并在联网时按需拉取免 Key 官方公开来源（FRED 指数 CSV、SEC EDGAR 公告、美联储/SEC/BLS 官方 RSS 与日历）。
# 2. 若你拥有下列任一合法免费/个人研究 API Key，可复制本文件为 apps/web/.env.local
#    或根目录 .env.local 并填入。密钥仅由 Next.js 服务端 Route Handler 读取，不会下发到前端。
# 3. 严禁将包含真实密钥的 .env / .env.local 提交到 Git 仓库。

# === 可选免费行情 / 资讯 / 日历 API Key（留空则不请求对应上游） ===

# Twelve Data Free（免费档 8 次/分、800 次/天；美股与美股 ETF 日线、60m 小时线与延迟报价）
TWELVE_DATA_API_KEY=

# Polygon.io (Massive) Stocks Free（免费档 5 次/分；美股与美股 ETF 60m/日线、最新昨收与新闻）
POLYGON_API_KEY=

# Finnhub Free（免费档 60 次/分；美股参考报价、公司/全市场新闻、经济日历与财报日历）
FINNHUB_API_KEY=

# EODHD Free（免费档 20 次/天；少量自选美股与港股 EOD 收盘日线）
EODHD_API_KEY=

# Tushare Pro（个人学习研究账号，需自行填写；仅用于 A 股收盘日线 EOD）
TUSHARE_TOKEN=

# === 免 Key 官方公开来源与可选本地工具（均为非密钥配置） ===

# SEC EDGAR 合规 User-Agent（SEC 官方要求包含应用名与联系信息，未填时使用项目级默认值）
SEC_EDGAR_USER_AGENT="TradeBuddy/0.2 (local-research; contact: trade-buddy-local@example.com)"

# 是否在无 Key 时在线拉取 FRED 官方公开指数日线 CSV（SP500 / NASDAQCOM），离线环境可设为 false
ENABLE_PUBLIC_FRED=true

# 是否在无 Key 时在线拉取官方公开资讯与日历（SEC EDGAR / 美联储 RSS / BLS 与 FRED 日历），离线可设为 false
ENABLE_PUBLIC_FEEDS=true

# 可选：是否启用本地 Python Baostock 适配器拉取 A 股日线（默认关闭 false；需本机预先 pip install baostock）
ENABLE_BAOSTOCK=false
