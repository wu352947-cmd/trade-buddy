# Trade Buddy 本地版可选数据源 API Key 配置模板
# ------------------------------------------------------------------
# 说明：
# 1. 不配置任何 Key 时，Trade Buddy 会自动使用仓库内捆绑的真实历史样本日线数据
#    以及免 Key 官方公开序列（如 FRED 宏观/指数日线），开箱即可完整看盘。
# 2. 若你拥有下列任一合法免费/个人研究 API Key，可复制本文件为 apps/web/.env.local
#    或根目录 .env.local 并填入。留空时程序不会发起对应上游请求。
# 3. 严禁将包含真实密钥的 .env / .env.local 提交到 Git 仓库。

# Twelve Data Free（免费档 8 次/分、800 次/天，适合美股与美股 ETF 日线/小时线）
TWELVE_DATA_API_KEY=

# Polygon.io (Massive) Stocks Free（免费档 5 次/分，适合美股与美股 ETF 日线）
POLYGON_API_KEY=

# Finnhub Free（免费档 60 次/分，适合美股最新参考报价）
FINNHUB_API_KEY=

# EODHD Free（免费档 20 次/天，适合少量自选美/港股 EOD 日线）
EODHD_API_KEY=

# Tushare Pro（个人学习研究账号，需具备相应积分以访问 A 股/港股/期货日线）
TUSHARE_TOKEN=

# 可选：是否在无 Key 时尝试在线拉取免 Key 的 FRED 官方公开日线（SP500 / NASDAQCOM / WTI）
# 默认开启（true）；若处于离线环境可设为 false 以完全零外网请求
ENABLE_PUBLIC_FRED=true
